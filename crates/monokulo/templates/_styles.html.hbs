<link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
<style>
/* Shared look for every monokulo page (registered as the "styles"
   partial - see templates.rs). Minimalistic / tech / Monero / semi-
   brutalist / web1.0: monospace throughout, hard black borders, no
   rounded corners, no shadows or gradients, one accent color (Monero
   orange). Deliberately hand-written, no framework, no external font
   request - the one same-origin exception is the favicon link just above,
   same reasoning as `pay::client_library`'s own static asset. */
:root {
  --ink: #111111;
  --paper: #f4f1ea;
  --paper-raised: #ffffff;
  --line: #111111;
  --accent: #ff6600;
  --accent-ink: #111111;
  --error: #b00020;
  --muted: #5a564c;
}
* { box-sizing: border-box; }
/* Minimal reset for form controls - browsers (and this file's own later,
   more specific `button, .btn` rule) give buttons/inputs/etc. their own
   default margin/font, which silently leaks into any context that isn't
   "a standalone block-level control with space below it" - e.g. a
   <button> reused as an inline nav link (`.nav-link-button` in
   `_nav.html.hbs`) inheriting a form button's `margin-top` and sitting
   visibly out of line with its sibling <a> tags. Reset the baseline here;
   components that genuinely want spacing (the real `button, .btn` rule
   below) declare it themselves, deliberately, rather than relying on a
   default nothing else was meant to inherit. */
button, input, textarea, select { margin: 0; font: inherit; }
html, body {
  margin: 0;
  padding: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  font-size: 15px;
  line-height: 1.5;
}
body { padding-bottom: 4rem; }
a { color: var(--ink); text-decoration: underline; text-decoration-thickness: 1px; }
a:hover { color: var(--accent); }
h1, h2, h3 { font-weight: 700; letter-spacing: -0.01em; margin: 1.4em 0 0.6em; }
h1 { font-size: 1.6rem; border-bottom: 3px solid var(--line); padding-bottom: 0.3em; }
h2 { font-size: 1.15rem; border-bottom: 1px solid var(--line); padding-bottom: 0.2em; }
p { margin: 0.6em 0; }
code, pre {
  font-family: inherit;
  background: var(--paper-raised);
  border: 1px solid var(--line);
  padding: 0.1em 0.35em;
}
pre { padding: 0.8em; overflow-x: auto; white-space: pre-wrap; word-break: break-all; }
.wrap { max-width: 880px; margin: 0 auto; padding: 0 1.2rem; }
.error {
  border: 2px solid var(--error);
  color: var(--error);
  padding: 0.6em 0.8em;
  font-weight: 700;
  margin: 1em 0;
}
.hint { color: var(--muted); font-size: 0.9em; }
.hero { display: flex; align-items: center; gap: 1.4rem; margin-top: 1.2rem; }
.hero-logo { flex: none; }
.hero h1 { margin-top: 0; }
@media (max-width: 560px) {
  .hero { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
}
.box {
  border: 2px solid var(--line);
  background: var(--paper-raised);
  padding: 1.1rem;
  margin: 1.2rem 0;
}
.box + .box { margin-top: 1.2rem; }
table { border-collapse: collapse; width: 100%; margin: 0.8em 0; }
th, td { border: 1px solid var(--line); padding: 0.4em 0.6em; text-align: left; vertical-align: top; }
/* A code/pre value inside a table cell (an address, a txid) shouldn't carry
   its own box on top of the cell's own border - the cell border is enough. */
td code, td pre, th code, th pre { background: none; border: none; padding: 0; }
th { background: var(--ink); color: var(--paper); font-weight: 700; }
tr:nth-child(even) td { background: rgba(0,0,0,0.03); }
/* Truncates long inline content (e.g. a public key in a list table) with an
   ellipsis, without letting it force its containing table wider than its
   own header row. Purely visual: CSS truncation never removes the full text
   from the DOM/accessibility tree, so the browser's own native find-in-page
   (see `tr:has(::target-text)` below) still matches against every character
   that's actually there, ellipsised or not. */
.ellipsis {
  display: inline-block;
  max-width: 16em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: bottom;
}
/* Highlights the whole row containing a native browser find-in-page match
   (Ctrl+F / Cmd+F) - no JS. `::target-text` is the pseudo-element the
   browser itself paints over a find match; `:has()` lets a plain selector
   react to an arbitrary descendant existing, reaching up from the matched
   text to the row around it. `@supports selector(...)` makes this a no-op,
   not a parse error, in a browser that doesn't understand
   `:has(::target-text)` yet. */
@supports selector(:has(::target-text)) {
  tr:has(::target-text) { background: #ffe3cc; }
}
form label { display: block; margin: 0.9em 0 0.3em; font-weight: 700; }
form .field-help { display: block; font-weight: 400; color: var(--muted); margin-top: 0.15em; font-size: 0.88em; }
input[type=text], input[type=email], input[type=password], input[type=url], select, textarea {
  width: 100%;
  font-family: inherit;
  font-size: 1em;
  padding: 0.45em 0.5em;
  border: 2px solid var(--line);
  background: #fff;
  color: var(--ink);
}
textarea { resize: vertical; }
input:focus, select:focus, textarea:focus { outline: 3px solid var(--accent); outline-offset: 0; }
button, .btn {
  display: inline-block;
  font-family: inherit;
  font-size: 1em;
  font-weight: 700;
  background: var(--ink);
  color: var(--paper);
  border: 2px solid var(--line);
  padding: 0.55em 1.1em;
  cursor: pointer;
  text-decoration: none;
  margin-top: 0.9em;
}
button:hover, .btn:hover { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
.btn-secondary { background: var(--paper-raised); color: var(--ink); }
.btn-secondary:hover { background: var(--accent); color: var(--accent-ink); }
.tag {
  display: inline-block;
  border: 1px solid var(--line);
  padding: 0.05em 0.5em;
  font-size: 0.8em;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.tag-ok { background: #dff5d8; }
.tag-error { background: #f8d7da; }
.tag-unknown { background: #eee; }
.tag-syncing { background: var(--accent); color: var(--accent-ink); }
.tag-stalled { background: #fff3cd; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
@media (max-width: 640px) { .grid-2 { grid-template-columns: 1fr; } }
.muted { color: var(--muted); }
.rule { border: none; border-top: 2px dashed var(--line); margin: 1.6em 0; }
.pick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin: 1.2rem 0; }
@media (max-width: 640px) { .pick-grid { grid-template-columns: 1fr; } }
.pick-card { border: 2px solid var(--line); background: var(--paper-raised); padding: 1.2rem; }
.pick-card h3 { margin-top: 0; }
.steps { padding-left: 1.4em; }
.steps li { margin: 0.5em 0; }
.help-disclosure { margin: 0.6em 0 1.2em; }
.help-disclosure summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1em;
  cursor: pointer;
  list-style: none;
  padding: 0.3em 0;
}
.help-disclosure summary::-webkit-details-marker { display: none; }
.help-disclosure summary .hint { text-decoration: underline; white-space: nowrap; }
.help-disclosure[open] summary .hint::after { content: " \25B4"; }
.help-disclosure:not([open]) summary .hint::after { content: " \25BE"; }
/* Nav bar - a semantic <nav>/<label>/checkbox structure rather than pure
   inline styles, so the small-screen hamburger below (a plain CSS checkbox
   toggle - no JS involved in showing/hiding the menu itself) has real
   selectors to work with. Above the breakpoint this all just renders as a
   normal flex row; the checkbox/label stay hidden and irrelevant. */
.site-nav { background: var(--ink); color: var(--paper); border-bottom: 3px solid var(--accent); }
.site-nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 0.7rem;
  padding-bottom: 0.7rem;
  flex-wrap: wrap;
  position: relative;
}
.site-nav-brand { color: var(--paper); text-decoration: none; font-weight: 700; letter-spacing: -0.02em; display: inline-flex; align-items: center; gap: 0.45em; }
.site-nav-logo { display: block; }
.site-nav-links { display: flex; align-items: center; flex-wrap: wrap; }
.site-nav-links a, .site-nav-links .nav-link-button {
  color: var(--paper);
  margin: 0 0 0 1.2em;
  background: none;
  border: none;
  font: inherit;
  cursor: pointer;
  padding: 0;
  text-decoration: underline;
  text-decoration-thickness: 1px;
}
.site-nav-links .nav-logout-form { margin: 0; display: inline; }
.nav-status-link { text-decoration: none !important; }
.nav-status-text { text-decoration: underline; }
.nav-toggle-checkbox { position: absolute; opacity: 0; pointer-events: none; }
.nav-toggle-label { display: none; color: var(--paper); font-size: 1.4rem; line-height: 1; cursor: pointer; user-select: none; }
/* No-JS-required small-screen menu: below the breakpoint, the link group
   wraps onto its own full-width row (the honest "progressive enhancement"
   fallback) *and* starts collapsed behind the checkbox-driven hamburger -
   pure CSS, nothing here depends on JS running at all. */
@media (max-width: 640px) {
  .nav-toggle-label { display: block; }
  .site-nav-links {
    flex-basis: 100%;
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6em;
    margin-top: 0.6em;
  }
  .site-nav-links a, .site-nav-links .nav-link-button { margin-left: 0; }
  .nav-toggle-checkbox:checked ~ .site-nav-links { display: flex; }
}
.status-dot {
  display: inline-block;
  width: 0.6em;
  height: 0.6em;
  border-radius: 50%;
  margin-left: 0.3em;
  vertical-align: middle;
  background: #888;
}
.status-dot-ok { background: #3dd15c; box-shadow: 0 0 6px 2px rgba(61,209,92,0.8); animation: status-pulse 2s ease-in-out infinite; }
.status-dot-error { background: #ff3b3b; box-shadow: 0 0 6px 2px rgba(255,59,59,0.8); animation: status-pulse 1.2s ease-in-out infinite; }
.status-dot-unknown { background: #888; box-shadow: none; animation: none; }
@keyframes status-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}
</style>
