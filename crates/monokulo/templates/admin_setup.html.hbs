<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Set up admin account - Monokulo</title>
{{> styles}}
</head>
<body>
{{> nav}}
<div class="wrap">

<h1>Set up your admin account</h1>
<p>This is a one-time step. The account created here is this instance's single administrator, and can configure every monokulo and scanner setting from the admin page afterward.</p>
{{#if error}}
<p class="error">{{error}}</p>
{{/if}}
<form method="post" action="/admin/setup">
<label>Email <input type="email" name="email" value="{{email}}" required></label>
<label>Password <input type="password" name="password" required minlength="12"></label>
<label>Confirm password <input type="password" name="confirm_password" required minlength="12"></label>
<button type="submit">Create admin account</button>
</form>

</div>
</body>
</html>
