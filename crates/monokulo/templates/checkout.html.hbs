<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{#unless is_terminal}}<meta http-equiv="refresh" content="10">{{/unless}}
<title>Pay with Monero</title>
{{> styles}}
<style>
/* This page is meant to be embedded in a merchant's own checkout flow via
   iframe - deliberately no site nav partial included, no top bar, nothing
   that reads as "you've left the merchant's site". It also carries
   *no script element at all* - a real customer paying real money must be able
   to trust and use this page with JavaScript disabled; a `<meta
   http-equiv="refresh">` above re-fetches the whole page every 10s while
   the order is still in progress (stopped once `is_terminal`, same as the
   old poll loop's own "stop once done" rule), and every value below
   (status, amounts, the progress bar's fill, the relative "expires in"
   time) is already correct in the HTML this response returns - see
   `http::checkout::checkout_page` and `templates::format_duration_until`.
   Reuses the same tokens `_styles.html.hbs` defines (monospace, hard
   borders, the one accent color) so it never reads as a foreign,
   third-party-widget-looking thing dropped into a merchant's page - but
   deliberately just ONE bordered surface for the whole widget, not a card
   nested inside another card: stacking a border around every sub-section
   the way an earlier version of this page did reads as a picture-in-
   picture video call, not a payment screen. */
body { padding: 1.2rem; background: var(--paper-raised); }
.pay-wrap { max-width: 380px; margin: 0 auto; text-align: center; }
.status-pending, .status-unconfirmed, .status-confirming, .status-partial { background: #fff3cd; }
.status-paid { background: #dff5d8; }
.status-expired, .status-unknown { background: #f8d7da; }
#status-badge { font-size: 0.85em; }
.amount { font-size: 2.2rem; font-weight: 700; margin: 0.7em 0 0.1em; letter-spacing: -0.01em; }
.fiat-amount { color: var(--muted); margin-bottom: 1.6em; }
.qr-wrap { margin: 0 0 1.6em; }
.qr-wrap svg { width: 190px; height: 190px; }
/* The address itself: plain monospace text, no button, no box of its own -
   select-and-copy (a long-press on mobile, a click-drag or triple-click on
   desktop) needs no JavaScript at all. A `<textarea readonly>` rather than
   a plain `<span>`/`<code>` specifically because a textarea's own native
   "click to focus, then select all" behavior (Ctrl+A, or most mobile
   browsers' own long-press "Select All" menu item) is real, JS-free
   platform behavior a plain text node doesn't get. */
.address-label { display: block; color: var(--muted); font-size: 0.8em; margin: 0 0 0.4em; }
.address-text {
  width: 100%;
  font-size: 0.85em;
  text-align: center;
  resize: none;
  border: 1px solid var(--line);
  background: none;
  padding: 0.6em;
  height: 3.4em;
}
.section {
  text-align: left;
  margin-top: 1.6em;
  padding-top: 1.4em;
  border-top: 1px solid var(--line);
}
.progress-row { display: flex; justify-content: space-between; font-size: 0.85em; margin-bottom: 0.4em; }
.progress-bar { border: 1px solid var(--line); height: 0.5em; background: var(--paper); }
.progress-fill { height: 100%; background: var(--accent); }
.payments-table { font-size: 0.8em; margin-top: 1.2em; }
.meta { margin-top: 1.4em; font-size: 0.8em; color: var(--muted); text-align: left; }
.visually-hidden {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}
</style>
</head>
<body>
<div class="pay-wrap">

<h1 class="visually-hidden">Monero payment of {{xmr_amount}} XMR</h1>

<span id="status-badge" class="tag {{status_class}}">{{status_label}}</span>

{{#if double_spend_detected_at}}
<div id="double-spend-banner" class="error" role="alert">
A payment toward this order was reversed by a blockchain double-spend, detected at
<span id="double-spend-time">{{{double_spend_detected_at_display}}}</span>.
{{#unless is_terminal}}This order's status above reflects only still-valid payments.{{/unless}}
</div>
{{/if}}

<span class="visually-hidden" id="amount-label">Amount due</span>
<div class="amount" id="xmr-amount" aria-labelledby="amount-label">{{xmr_amount}} XMR</div>
<div class="fiat-amount">&asymp; {{amount}} {{currency}}</div>

<!-- The QR code is redundant with the copyable address text right below it,
     so it's hidden from assistive tech (qr_svg_for_html stamps
     role="presentation" aria-hidden="true" focusable="false" onto the SVG
     itself) rather than announced as an unlabeled image. -->
<div class="qr-wrap">{{{qr_code_svg}}}</div>

<span class="address-label" id="address-label">Payment address (tap to focus, then select all to copy)</span>
<textarea class="address-text" id="address" readonly aria-labelledby="address-label">{{address}}</textarea>

<div class="section">
<div class="progress-row">
<span id="confirmations-label">{{confirmations}} / {{confirmations_required}} confirmations</span>
<span id="received-label">{{amount_received_xmr}} XMR received</span>
</div>
<div class="progress-bar" id="progress-bar" role="progressbar" aria-labelledby="confirmations-label"
     aria-valuemin="0" aria-valuemax="{{confirmations_required}}" aria-valuenow="{{confirmations}}"
     aria-valuetext="{{confirmations}} of {{confirmations_required}} confirmations">
<div class="progress-fill" id="progress-fill" style="width: {{progress_percent}}%"></div>
</div>
</div>

<div class="section">
{{#if refund_address}}
<span class="address-label" id="refund-address-label">Refund address</span>
<textarea class="address-text" id="refund-address" readonly aria-labelledby="refund-address-label">{{refund_address}}</textarea>
{{else}}
<form method="post" action="/pay/{{pk}}/orders/{{payment_id}}/refund-address">
<label class="address-label" for="refund_address">Refund address (optional)</label>
{{#if refund_address_error}}<div class="error">{{refund_address_error}}</div>{{/if}}
<input type="text" id="refund_address" name="refund_address" placeholder="Your own Monero address, in case a refund is ever needed">
<button type="submit" class="btn-secondary">Save</button>
</form>
{{/if}}
</div>

{{#if payments}}
<table class="payments-table">
<caption class="visually-hidden">Individual payments received toward this order</caption>
<thead><tr><th scope="col">Tx</th><th scope="col">Amount</th><th scope="col">Confirmations</th></tr></thead>
<tbody id="payments-body">
{{#each payments}}
<tr>
<td>{{this.txid_short}}</td>
<td>{{this.amount_xmr}} XMR</td>
<td>{{#if this.is_zero_conf}}mempool{{else}}{{this.confirmations}}{{/if}}</td>
</tr>
{{/each}}
</tbody>
</table>
{{/if}}

<div class="meta">
Payment ID: {{payment_id}}<br>
{{#unless is_terminal}}Expires in {{expires_in_display}}{{/unless}}
</div>

</div>
</body>
</html>
