# monokulo-push-relay as a systemd service, under a user systemd makes for
# it (DynamicUser), its handles in /var/lib/monokulo/push-relay/.
#
# Install, as root, from the unzipped folder:
#   install -m 755 monokulo-push-relay /usr/local/bin/
#   install -d /etc/monokulo
#   install -m 644 relay.toml /etc/monokulo/relay.toml    # then set server.public_uri and your apps
#   install -m 600 /dev/null /etc/monokulo/monokulo-push-relay.env
#   printf "MONOKULO_RELAY_HANDLE_KEY='%s'\n" "$(openssl rand -hex 32)" >> /etc/monokulo/monokulo-push-relay.env
#   install -m 644 service/monokulo-push-relay.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now monokulo-push-relay
#
# The environment file (root's alone: systemd reads it before the service
# starts) holds the secrets, one VARIABLE='value' each; single quotes keep a
# value as it is, over several lines too, so the APNs key and the FCM
# service account go in whole:
#   MONOKULO_RELAY_HANDLE_KEY='<64 hex characters>'          # required; keep it
#   MONOKULO_RELAY_APNS_KEY='<the AuthKey_….p8 file, whole>'   # for APNs
#   MONOKULO_RELAY_FCM_CREDENTIALS='<the service account JSON, whole>'   # for FCM
#
# Each start runs --check first, so a bad setting stops it with the reason:
# `systemctl status monokulo-push-relay` and `journalctl -u
# monokulo-push-relay` show it. The status for this machine:
# `curl -s http://127.0.0.1:8446/status`. The relay serves no TLS: put an
# https reverse proxy in front, serving server.public_uri. Every setting:
# https://docs.monokulo.com/push-relay/

[Unit]
Description=monokulo-push-relay, Web Push handed on to APNs and FCM
Documentation=https://docs.monokulo.com/push-relay/
After=network-online.target
Wants=network-online.target
# A setting --check refuses is not retried for ever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
StateDirectory=monokulo/push-relay
StateDirectoryMode=0700
EnvironmentFile=/etc/monokulo/monokulo-push-relay.env
ExecStartPre=/usr/local/bin/monokulo-push-relay --options /etc/monokulo/relay.toml --store-path %S/monokulo/push-relay/push-relay.db --check
ExecStart=/usr/local/bin/monokulo-push-relay --options /etc/monokulo/relay.toml --store-path %S/monokulo/push-relay/push-relay.db
Restart=on-failure
RestartSec=5
# SIGTERM lets pushes in flight finish.
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_NETLINK for getaddrinfo, which asks the kernel for the addresses it sorts by.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
