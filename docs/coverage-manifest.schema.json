{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monokulo coverage component manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["component", "revision", "tools", "test", "lines", "branches", "report", "unavailable"],
  "properties": {
    "component": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "tools": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "required": ["rustc", "cargo", "collector"],
      "properties": {
        "rustc": {"type": "string", "minLength": 1},
        "cargo": {"type": "string", "minLength": 1},
        "collector": {"type": "string", "minLength": 1}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "command", "exit_code", "log"],
      "properties": {
        "status": {"enum": ["passed", "failed", "unavailable"]},
        "command": {"type": "string"},
        "exit_code": {"type": ["integer", "null"]},
        "log": {"type": ["string", "null"]}
      }
    },
    "lines": {"$ref": "#/$defs/counts"},
    "branches": {"$ref": "#/$defs/counts"},
    "report": {"type": ["string", "null"]},
    "unavailable": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["lines", "branches", "report"]}
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "total"],
      "properties": {
        "covered": {"type": ["integer", "null"], "minimum": 0},
        "total": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
