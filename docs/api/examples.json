      "_templates": {
        "create-order": {
          "contentType": "application/json",
          "method": "POST",
          "properties": [
            {
              "maxLength": 40,
              "name": "amount",
              "placeholder": "12.50",
              "prompt": "The price, in `currency`.",
              "regex": "^[0-9]+(\\.[0-9]{1,12})?$",
              "required": true,
              "type": "text"
            },
            {
              "name": "currency",
              "placeholder": "EUR",
              "prompt": "The currency of `amount`.",
              "regex": "^[A-Za-z0-9]{2,10}$",
              "required": true,
              "type": "text"
            },
            {
              "maxLength": 140,
              "minLength": 1,
              "name": "description",
              "placeholder": "Order #1042: Blue mug + 2 more",
              "prompt": "What the order is for, shown to the payer under the store's name.\nWithout one the checkout shows the store's payment description.",
              "regex": "^[^\\x00-\\x1F\\x7F-\\x9F]*$",
              "type": "text"
            },
            {
              "maxLength": 100,
              "minLength": 1,
              "name": "idempotency_key",
              "placeholder": "order-1042-total-1250",
              "prompt": "The caller's key for this one purchase: a retry with the same key\ngets the order the first attempt made, never a second one.",
              "regex": "^[!-~]+$",
              "type": "text"
            },
            {
              "maxLength": 120,
              "minLength": 1,
              "name": "merchant_order_id",
              "placeholder": "1042",
              "prompt": "The shop's own reference for the order (its order or cart number).",
              "type": "text"
            },
            {
              "name": "show_merchant_order_id",
              "prompt": "Whether the checkout shows the payer `merchant_order_id`; true when\nleft out. A shop whose reference means nothing to its customers\nsends false.",
              "type": "checkbox"
            }
          ],
          "target": "/api/v1/orders",
          "title": "Make an order."
        }
      }
    }
  },
