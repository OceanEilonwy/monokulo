config monokulo-bell 'main'
	option enabled '1'
	# The port the points of sale and the tills reach (bell.listen).
	option port '8445'
	# 'loopback' (127.0.0.1: an https proxy on this router in front, the
	# usual way), 'lan' to listen on the LAN address only, or 'all'
	option listen 'loopback'
	# The Bell's database (the tills' registrations alone). Must be on
	# storage, not /tmp. Kept across firmware upgrades if left here.
	option data_dir '/srv/monokulo-bell'
	# Required: the https address the points of sale and the tills reach
	# this Bell at, served by a TLS proxy in front of it.
	#option public_uri 'https://bell.example.org'
	# Every other setting is the Bell's own default until set here or in
	# LuCI (Services > Bell): trusted_proxy (a list), timeout_ms,
	# registrations_per_minute, registration_failure_limit,
	# dings_per_merchant_per_minute, allow_private_endpoints, log_level,
	# log_format.

# Each point of sale the Bell serves: set its application_id to turn it on
# (and its secret in LuCI). environment and api_url are the Bell's
# defaults until set.
config square 'square'
	#option application_id 'sq0idp-...'
	#option environment 'production'

config clover 'clover'
	#option application_id 'ABCDEFGHJKMNP'
	#option environment 'north_america'
