config monokulo-push-relay 'main'
	option enabled '1'
	# The port apps register on and senders push to (server.listen).
	option port '8444'
	# 'lan' to listen on the LAN address only, 'all' interfaces, or
	# 'loopback' (127.0.0.1: an https proxy on this router in front)
	option listen 'lan'
	# The relay's database (its handles alone, never a push). Must be on
	# storage, not /tmp. Kept across firmware upgrades if left here.
	option data_dir '/srv/monokulo-push-relay'
	# Required: the https address apps and senders reach this relay at,
	# served by a TLS proxy in front of it.
	#option public_uri 'https://relay.example.org'
	# Every other setting is the relay's own default until set here or in
	# LuCI (Services > Push relay): trusted_proxy (a list),
	# upstream_timeout_ms, ttl_days, unused_ttl_days, per_sender_per_minute,
	# per_handle_per_minute, registrations_per_minute, apns_team_id,
	# apns_key_id, apns_endpoint, fcm_endpoint, log_level, log_format.

# One section per app devices may register for, by the name they register
# with; its iOS bundle ID for APNs, its Firebase project ID for FCM, or both.
#config app
#	option name 'monokular'
#	option apns_topic 'com.example.monokular'
#	option fcm_project_id 'monokular-12345'
