config monokulo 'main'
	option enabled '1'
	option port '8081'
	# 'lan' to listen on the LAN address only, 'all' interfaces, or 'loopback'
	option listen 'lan'
	# The engine's port, always on 127.0.0.1: only monokulo talks to it
	option engine_port '8443'
	# Databases, logs and the options files monokulo's admin page saves.
	# Must be on storage, not /tmp. Kept across firmware upgrades if left here.
	option data_dir '/srv/monokulo'
	# CPUs the engine may use (taskset list), so catching up with the chain
	# leaves the rest for routing. Empty: all of them.
	option engine_cpus '2,3'
	# The engine's nice level: 0 (normal) to 19 (lowest priority)
	option engine_nice '10'
