#!/bin/sh
# Starts the engine on the CPUs named in the first argument (a taskset list;
# empty for all of them), with the rest of the arguments as its own.
#
# The init script runs the engine through this rather than through taskset
# directly because procd names an instance's log lines after its command:
# installed as /usr/libexec/monokulo/monokulo-engine, the lines still say
# monokulo-engine. The engine sizes its scan slots from the CPUs it may use.
cpus=$1
shift
[ -n "$cpus" ] && exec taskset -c "$cpus" /usr/bin/monokulo-engine "$@"
exec /usr/bin/monokulo-engine "$@"
