{
	"luci-app-monokulo": {
		"description": "Grant access to Monokulo settings",
		"read": {
			"ubus": {
				"monokulo": [ "status" ]
			},
			"uci": [ "monokulo" ],
			"file": {
				"*/tor/hostname": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"monokulo": [ "restart" ]
			},
			"uci": [ "monokulo" ]
		}
	}
}
