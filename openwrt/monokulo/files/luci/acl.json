{
	"luci-app-monokulo": {
		"description": "Grant access to Monokulo settings",
		"read": {
			"ubus": {
				"service": [ "list" ]
			},
			"uci": [ "monokulo" ],
			"file": {
				"*/tor/hostname": [ "read" ],
				"/usr/share/monokulo/version": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"luci": [ "setInitAction" ]
			},
			"uci": [ "monokulo" ]
		}
	}
}
