/target

# SQLite database + WAL/SHM sidecar files created by running moneropay-core
# locally (Store::open_file("moneropay.db") in main.rs) - runtime state, not
# source. e2e/ has its own copy of this pattern for the same reason.
moneropay.db
moneropay.db-shm
moneropay.db-wal

# scripts/dev-run.sh's own working state (PID files, logs, both real
# processes' SQLite databases, a locally-generated dev
# CONTROL_PLANE_ENCRYPTION_KEY) - see that script's own header comment.
/.dev-run/

# cli-wallet wallet files: the lock taken around every change (and the
# note of who holds it), and SQLite's journal while a write is under way.
/e2e/wallets/**/*.db.lock
/e2e/wallets/**/*.db.lock.holder
/e2e/wallets/**/*.db-journal

# scripts/build-openwrt.sh: the binaries it drops into the package, the
# packages and repository, and the landing page site.
/openwrt/monokulo/files/monokulo
/openwrt/monokulo/files/monokulo-engine
/dist/
/site/
