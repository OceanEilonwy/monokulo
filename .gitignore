/target

# The databases monokulo and the engine make in the working directory when
# there is no data directory to use, and their WAL/SHM sidecars.
monokulo.db
monokulo.db-shm
monokulo.db-wal
engine.db
engine.db-shm
engine.db-wal

# scripts/dev-run.sh's own working state (PID file, log, the databases and
# a locally generated dev MONOKULO_ENCRYPTION_KEY) - see that script's own
# header comment.
/.dev-run/

# cli-wallet wallet files: the lock taken around every change (and the
# note of who holds it), and SQLite's journal while a write is under way.
/e2e/wallets/**/*.db.lock
/e2e/wallets/**/*.db.lock.holder
/e2e/wallets/**/*.db-journal

# scripts/build-openwrt.sh: the binaries it drops into the package, the
# packages and repository.
/openwrt/monokulo/files/monokulo
/dist/

# JavaScript workspace outputs
node_modules/
crates/ui/dist/
apps/*/dist/
/test-results/
/playwright-report/
crates/ui/test-results/

# Editor swap files (Kate).
*.kate-swp
