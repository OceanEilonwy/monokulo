# Composer-managed PHPUnit + polyfills for this plugin's own test suite -
# reproducible from composer.json/composer.lock (both committed), not source.
/vendor/

# wp-env's own local state (docker volumes tracked outside this directory,
# but it occasionally leaves a marker here) - never anything this plugin
# needs to ship or version.
/.wp-env-override.json

# PHPUnit's own incremental test-result cache (which tests failed last run,
# used only to support --order-by=defects locally) - regenerated on every
# run, environment-specific, not something two developers' runs should fight
# over in version control.
/.phpunit.result.cache

# tests/LiveEngineIntegrationTest.php's own local pointer to a real, running
# moneropay-core engine (base URL + tenant public key) - see that test file's
# own doc comment. Deliberately not committed: the engine container name and
# bootstrapped public_key are both specific to whoever's local Docker setup
# started it, and a fresh engine (or a fresh DB) mints a brand new public_key
# every time - there is nothing stable here for two developers' runs to share.
/tests/live-engine.local.json
