<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="{{meta_refresh_secs}}">
<title>Order detail - MoneroPay Cloud</title>
{{> styles}}
<style>
.kv-table th { width: 14em; }
.kv-table td, .payments-table td { word-break: break-all; overflow-wrap: anywhere; }
.payments-table th { min-width: 8em; }
.order-title { display: flex; align-items: center; justify-content: space-between; gap: 0.8em; }
.share-btn {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.5em;
  height: 1.5em;
  border: 2px solid var(--line);
  color: var(--ink);
  text-decoration: none;
}
.share-btn:hover { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); }
.share-btn svg { width: 60%; height: 60%; }
.progress-bar { border: 1px solid var(--line); height: 0.5em; background: var(--paper); margin: 0.6em 0 1em; }
.progress-fill { height: 100%; background: var(--accent); }
</style>
</head>
<body>
{{> nav}}
<div class="wrap">

<p><a href="/dashboard/connections/{{connection_id}}/orders">&larr; back to orders</a></p>
{{#if order}}
<h1 class="order-title">
<span>Order {{order.payment_id}}</span>
<a class="share-btn" id="share-payment-link" href="{{order.payment_link}}" target="_blank" rel="noopener"
   aria-label="Share payment link" title="Share payment link">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<circle cx="18" cy="5" r="3"></circle>
<circle cx="6" cy="12" r="3"></circle>
<circle cx="18" cy="19" r="3"></circle>
<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
</svg>
</a>
</h1>
<p class="hint">This page refreshes automatically every 15s. Share the payment link (icon above) with whoever
needs to pay this order.</p>
<table class="kv-table">
<tr><th>Merchant order ID</th><td>{{#if order.merchant_order_id}}{{order.merchant_order_id}}{{else}}<span class="muted">-</span>{{/if}}</td></tr>
<tr><th>Address</th><td><code>{{order.address}}</code></td></tr>
<tr><th>Amount</th><td>{{order.amount}} {{order.currency}}</td></tr>
<tr><th>Exchange rate</th><td>{{order.rate_display}}</td></tr>
<tr><th>Rate provider</th><td>{{order.rate_provider}}</td></tr>
<tr><th>XMR amount (piconero)</th><td>{{order.xmr_amount_piconero}}</td></tr>
<tr><th>Amount received (piconero)</th><td>{{order.amount_received_piconero}}</td></tr>
<tr><th>Status</th><td>{{order.status}}
{{#if order.rescan.progress}}
{{#if order.rescan.progress.stalled}}
<span class="tag tag-stalled">Stalled at {{order.rescan.progress.percent_complete}}%</span>
{{else}}
<span class="tag tag-syncing">Syncing {{order.rescan.progress.percent_complete}}%</span>
{{/if}}
{{/if}}
</td></tr>
<tr><th>Confirmations</th><td>{{order.confirmations}}</td></tr>
{{#if order.double_spend_detected_at}}
<tr><th>Double-spend detected at</th><td>{{{order.double_spend_detected_at_display}}}</td></tr>
{{/if}}
<tr><th>Refund address</th><td>{{#if order.refund_address}}<code>{{order.refund_address}}</code>{{else}}<span class="muted">-</span>{{/if}}</td></tr>
<tr><th>Created at</th><td>{{{order.created_at_display}}}</td></tr>
<tr><th>Expires at</th><td>{{{order.expires_at_display}}}</td></tr>
<tr><th>Updated at</th><td>{{{order.updated_at_display}}}</td></tr>
<tr><th>Scan range</th><td>{{{order.scan_range_display}}}</td></tr>
</table>
<h2>Payments</h2>
<table class="payments-table">
<thead>
<tr><th>Txid</th><th>Output index</th><th>Amount (piconero)</th><th>First seen</th><th>Block height</th><th>Voided at</th></tr>
</thead>
<tbody>
{{#each order.payments}}
<tr>
<td><code>{{this.txid}}</code></td>
<td>{{this.output_index}}</td>
<td>{{this.amount_piconero}}</td>
<td>{{{this.first_seen_at_display}}}</td>
<td>{{{this.block_height_display}}}</td>
<td>{{{this.voided_at_display}}}</td>
</tr>
{{/each}}
</tbody>
</table>

{{#if order.rescan_error}}<p class="error">{{order.rescan_error}}</p>{{/if}}
{{#if order.rescan}}
<h2>Rescan for late payment</h2>
{{#if order.rescan.progress}}
{{#if order.rescan.progress.stalled}}
<p class="hint">This rescan hasn't made progress in a while - it may have stalled. It will resume on its own if
the server restarts; otherwise you may want to wait a bit longer or check the server's own logs.</p>
{{else}}
<p class="hint">Rescanning ({{order.rescan.progress.mode}} mode) - this can take a while for a wide date range.</p>
{{/if}}
<div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100"
     aria-valuenow="{{order.rescan.progress.percent_complete}}"
     aria-valuetext="{{order.rescan.progress.percent_complete}}% complete">
<div class="progress-fill" style="width: {{order.rescan.progress.percent_complete}}%"></div>
</div>
{{/if}}
{{#if order.rescan.form}}
<p class="hint">This order expired before a payment was detected. If the customer says they sent funds anyway,
scan the chain again for a late arrival.</p>
<form method="post" action="/dashboard/connections/{{connection_id}}/orders/{{order.payment_id}}/rescan">
<p><label><input type="radio" name="mode" value="simple" checked> {{{order.rescan.form.simple_label}}}</label></p>
<p><label><input type="radio" name="mode" value="advanced"> Advanced - choose a range</label></p>
<p class="grid-2">
<label>From <input type="date" id="rescan-from" name="from" min="{{order.rescan.form.min_date}}" max="{{order.rescan.form.max_date}}">
<span class="hint" id="rescan-from-local"></span></label>
<label>To <input type="date" id="rescan-to" name="to" min="{{order.rescan.form.min_date}}" max="{{order.rescan.form.max_date}}">
<span class="hint" id="rescan-to-local"></span></label>
</p>
<p class="hint">{{order.rescan.form.bound_text}}</p>
<button type="submit" class="btn">Rescan for late payment</button>
</form>
{{/if}}
{{/if}}

{{else}}
<h1>Order not found</h1>
<p>This order does not exist.</p>
{{/if}}

</div>
{{#if order}}
<script>
(function () {
  // Progressive enhancement only - the share button is a real, working
  // <a href> to the payment link either way (opens it in a new tab, same
  // as the old "open" link this replaced). Where the native Web Share API
  // is available (most mobile browsers, some desktop ones), this hands the
  // link to the device's own share sheet instead of just navigating.
  var link = document.getElementById("share-payment-link");
  if (!link || typeof navigator.share !== "function") return;
  link.addEventListener("click", function (event) {
    event.preventDefault();
    navigator.share({ title: "Pay this Monero order", url: link.href }).catch(function () {});
  });
})();
</script>
<script>
(function () {
  // Progressive enhancement only - every rescan date shown/entered here is
  // authoritative in UTC either way (server-rendered, server-validated); this
  // only adds a local-time reading alongside it for a JS-enabled viewer's own
  // convenience. Never changes what gets submitted.
  if (typeof Intl === "undefined" || typeof Intl.DateTimeFormat !== "function") return;

  function localLabel(dateStr) {
    if (!dateStr) return "";
    var d = new Date(dateStr + "T00:00:00Z");
    if (isNaN(d.getTime())) return "";
    return d.toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
  }

  var simpleDateSpan = document.querySelector("[data-utc-date]");
  if (simpleDateSpan) {
    var simpleLocal = localLabel(simpleDateSpan.getAttribute("data-utc-date"));
    if (simpleLocal) {
      simpleDateSpan.textContent += " (your time: " + simpleLocal + ")";
    }
  }

  ["from", "to"].forEach(function (name) {
    var input = document.getElementById("rescan-" + name);
    var hint = document.getElementById("rescan-" + name + "-local");
    if (!input || !hint) return;
    function update() {
      var local = localLabel(input.value);
      hint.textContent = local ? "= " + local + " your time" : "";
    }
    input.addEventListener("change", update);
    update();
  });
})();
</script>
{{/if}}
</body>
</html>
