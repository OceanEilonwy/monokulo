<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Orders - MoneroPay Cloud</title>
{{> styles}}
</head>
<body>
{{> nav}}
<div class="wrap">

<p><a href="/dashboard/connections/{{connection_id}}">&larr; back to store</a></p>
<h1>Orders</h1>
<table>
<thead>
<tr><th>Payment ID</th><th>Status</th><th>Amount</th><th>Created</th></tr>
</thead>
<tbody>
{{#each orders}}
<tr>
<td><a href="/dashboard/connections/{{../connection_id}}/orders/{{this.payment_id}}">{{this.payment_id}}</a></td>
<td>{{this.status}}</td>
<td>{{this.amount}} {{this.currency}}</td>
<td>{{this.created_at}}</td>
</tr>
{{/each}}
</tbody>
</table>

</div>
</body>
</html>
