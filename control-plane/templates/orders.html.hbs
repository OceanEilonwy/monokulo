<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Orders - MoneroPay Cloud</title>
</head>
<body>
<h1>Orders</h1>
<table>
<thead>
<tr><th>Payment ID</th><th>Status</th><th>Amount</th><th>Created</th></tr>
</thead>
<tbody>
{{#each orders}}
<tr>
<td><a href="/dashboard/connections/{{../connection_id}}/orders/{{this.payment_id}}">{{this.payment_id}}</a></td>
<td>{{this.status}}</td>
<td>{{this.fiat_amount}} {{this.fiat_currency}}</td>
<td>{{this.created_at}}</td>
</tr>
{{/each}}
</tbody>
</table>
</body>
</html>
