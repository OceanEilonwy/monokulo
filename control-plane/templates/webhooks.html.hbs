<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Webhooks - MoneroPay Cloud</title>
{{> styles}}
</head>
<body>
{{> nav}}
<div class="wrap">

<p><a href="/dashboard/connections/{{connection_id}}">&larr; back to store</a></p>
<h1>Webhooks</h1>
<table>
<thead>
<tr><th>Webhook ID</th><th>URL</th><th>Enabled</th><th>Created</th></tr>
</thead>
<tbody>
{{#each webhooks}}
<tr>
<td>{{this.webhook_id}}</td>
<td>{{this.url}}</td>
<td>{{this.enabled}}</td>
<td>{{this.created_at}}</td>
</tr>
{{/each}}
</tbody>
</table>

</div>
</body>
</html>
