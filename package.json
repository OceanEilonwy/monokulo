{
  "name": "monokulo-web",
  "private": true,
  "workspaces": [
    "crates/ui",
    "apps/stylebook",
    "crates/monokulo/pos-ui",
    "crates/monokulo/engine-ui"
  ],
  "scripts": {
    "stylebook": "npm run dev -w @monokulo/stylebook",
    "build:stylebook": "npm run build -w @monokulo/stylebook",
    "build:ui": "npm run build -w @monokulo/ui",
    "test:ui": "playwright test -c crates/ui/playwright.config.js",
    "lint:ui": "node crates/ui/tools/lint.mjs",
    "test:ui:unit": "node --test crates/ui/tools/lint.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "postcss": "8.5.28",
    "parse5": "7.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
