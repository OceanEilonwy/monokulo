# cli-wallet wallet files are SQLite databases; see crates/cli-wallet/README.md
# for the textconv that makes their diffs readable.
/e2e/wallets/**/*.db binary diff=sqlite3
# Generated by `cargo xtask ui` from crates/ui; collapsed in GitHub diffs.
crates/ui/solid/** linguist-generated=true
# Written by tests and compared byte for byte with what they write again:
# LF on every checkout, so Windows' line endings don't fail the comparison.
xtask/src/pages/docs/webhook-vectors.json text eol=lf
apps/engine/test/fixtures.json text eol=lf
